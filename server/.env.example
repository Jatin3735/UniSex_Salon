# ---- MongoDB ----
# Get a free connection string from https://cloud.mongodb.com
# Atlas format (replace USER, PASS and the cluster host):
#   mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/salonx?retryWrites=true&w=majority
# Local install format:
#   mongodb://127.0.0.1:27017/salonx
MONGODB_URI=

# ---- Auth ----
# Any long random string, AT LEAST 32 chars (the server refuses to boot with a
# shorter one). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Server ----
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# The salon's wall-clock timezone. All availability "today"/"now" math is done
# against this, so it is correct no matter what timezone the host runs in.
SALON_TZ=Asia/Kolkata

# In production set NODE_ENV=production. Leave DEBUG_ERRORS unset (or "false")
# so 500 responses never leak stack traces; set it to "true" only for local
# debugging.
# NODE_ENV=production
# DEBUG_ERRORS=false

# Set to "false" to skip seeding demo services, staff and logins on boot.
SEED_ON_BOOT=true

# Set to "true" ONLY to disable the auth/API rate limiters (e.g. the smoke
# test's burst of auth calls). Leave unset in production — the limiters are the
# brute-force / scraping defence.
# RATE_LIMIT_DISABLED=false
