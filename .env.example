# Front-end env (Vite). Copy to `.env` and adjust only if you move the API.
# All real secrets live in server/.env — these values ship in the client bundle.
VITE_API_URL=http://localhost:5000

# Secret URL the hidden admin panel is served at, e.g. http://localhost:5173/<this>.
# There is no link to it anywhere in the UI. Pick your own unguessable value.
# NOTE: this string is compiled into the JS bundle, so it is discoverable by
# someone inspecting the built assets — the credential gate + admin-role check
# + server-side role guards are the real protection, not the path's secrecy.
VITE_ADMIN_PATH=sx-console-x7k9q2
